# Токен бота від @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID адміністратора (отримати у @userinfobot)
ADMIN_ID=123456789

# (Опційно) username менеджера без @ — для кнопки "Написати менеджеру"
MANAGER_USERNAME=your_manager

# --- Лише для деплою на Vercel (webhook + KV) ---
# Секрет для перевірки запитів вебхука від Telegram (будь-який рядок A-Za-z0-9_-)
TELEGRAM_WEBHOOK_SECRET=change_me_secret
# Секрет для доступу до /api/setup
SETUP_SECRET=change_me_setup
# KV_REST_API_URL / KV_REST_API_TOKEN додає інтеграція Vercel KV автоматично
